    {
      "id": "T3",
      "file": "src/vortex/catalog_synth.py",
      "depends_on": [
        "T1",
        "T2"
      ],
      "brief": "Replace the whole file with exactly:\n\n    \"\"\"Discovered model -> catalog entry (the operator's Add click).\"\"\"\n    from __future__ import annotations\n\n    import os\n    import re\n\n    from .catalog import Catalog, CatalogEntry\n    from .discovery import DiscoveredModel\n\n    PORT_RANGE = range(8200, 8300)\n    RUNTIME_BINARIES = {\"mlx\": \"/opt/homebrew/bin/mlx-serve\",\n                        \"gguf\": \"/opt/homebrew/bin/llama-server\"}\n\n\n    class SynthesisError(ValueError):\n        \"\"\"A discovered model that cannot become a catalog entry.\"\"\"\n\n\n    def synthesize_entry(model: DiscoveredModel, catalog: Catalog,\n                         binaries: dict[str, str] = RUNTIME_BINARIES) -> CatalogEntry:\n        path, fmt = model.path, model.fmt\n        if path is None:\n            raise SynthesisError(f\"no local path known for {model.key}\")\n        if fmt not in binaries:\n            raise SynthesisError(f\"unsupported format {fmt}\")\n        if model.architecture is None:\n            raise SynthesisError(\"no architecture reported (not a chat model)\")\n        pid = re.sub(r\"[^a-z0-9._-]\", \"-\", model.key.lower())\n        for e in catalog.entries:\n            if e.public_id == pid or e.source_path == path or path in e.launch_command:\n                raise SynthesisError(f\"already in the catalog as {e.public_id}\")\n        free = [p for p in PORT_RANGE if p not in {e.port for e in catalog.entries}]\n        if not free:\n            raise SynthesisError(\"no free port in 8200-8299\")\n        port = free[0]\n        net = [\"--host\", \"127.0.0.1\", \"--port\", str(port)]\n        if fmt == \"mlx\":\n            rt, eng, cmd = \"mlx-serve\", \"mlx-serve\", [binaries[fmt], \"--model\", path, \"--serve\"]\n        else:\n            rt, eng, cmd = \"llama-server\", \"llama.cpp\", [binaries[fmt], \"-m\", path]\n        ram = round(model.size_bytes * 1.1 / 1e9, 1) if model.size_bytes else None\n        base = f\"http://127.0.0.1:{port}/v1\"\n        return CatalogEntry.model_validate({\n            \"public_id\": pid, \"runtime\": rt, \"engine\": eng,\n            \"launch_command\": cmd + net, \"port\": port,\n            \"ready_url\": f\"{base}/models\", \"chat_endpoint\": f\"{base}/chat/completions\",\n            \"upstream_alias\": os.path.basename(path.rstrip(\"/\")),\n            \"ram_estimate_gb\": ram, \"exclusive\": ram is not None and ram > 40,\n            \"source_path\": path, \"origin\": \"local\"})\n\nSelf-verify: ruff and mypy clean; dict keys are exactly the fields shown.",
      "contracts": [
        "src.vortex.catalog_synth",
        "src.vortex.catalog_synth:PORT_RANGE",
        "src.vortex.catalog_synth:RUNTIME_BINARIES",
        "src.vortex.catalog_synth:SynthesisError",
        "src.vortex.catalog_synth:synthesize_entry"
      ],
      "tests": [
        "tests/test_catalog_synth.py::test_a_model_already_in_the_catalog_is_refused",
        "tests/test_catalog_synth.py::test_gguf_model_becomes_a_llama_server_entry",
        "tests/test_catalog_synth.py::test_lowest_free_port_skips_ports_the_catalog_uses",
        "tests/test_catalog_synth.py::test_mlx_model_becomes_an_mlx_serve_entry",
        "tests/test_catalog_synth.py::test_no_free_port_is_refused",
        "tests/test_catalog_synth.py::test_port_range_and_binaries_are_the_ceo_policy",
        "tests/test_catalog_synth.py::test_public_id_is_sanitized_from_the_key",
        "tests/test_catalog_synth.py::test_ram_estimate_is_size_plus_ten_percent_and_sets_exclusive",
        "tests/test_catalog_synth.py::test_unsynthesizable_models_raise_with_a_reason[overrides0-path]",
        "tests/test_catalog_synth.py::test_unsynthesizable_models_raise_with_a_reason[overrides1-format]",
        "tests/test_catalog_synth.py::test_unsynthesizable_models_raise_with_a_reason[overrides2-architecture]"
      ]
    },
    {
      "id": "T4",
      "file": "src/vortex/app.py",
      "depends_on": [
        "T3"
      ],
      "brief": "In build_app, use the existing `catalog`, `lifecycle`, `ops`, `model_cache`,\n`_get_models()`. Add `save_local_entries` to the `from .catalog import` line;\nadd `from .catalog_synth import SynthesisError, synthesize_entry`. Add keyword\n`local_catalog_path: Path | None = None` last in the signature. Replace\n`catalog = catalog or load_catalog(...)` with:\n\n    if catalog is None:\n        local_catalog_path = local_catalog_path or _REPO_ROOT / \"config/catalog.local.json\"\n        catalog = load_catalog(_REPO_ROOT / \"config/catalog.json\", local_path=local_catalog_path)\n\n    def _persist() -> None:\n        if local_catalog_path is not None:\n            save_local_entries(catalog, local_catalog_path)\n        model_cache.clear()\n\n`/api/catalog` rows must include `origin`, `source_path`. Routes:\n\n    @app.post(\"/api/discovered-models/{key}/add\", status_code=201)\n    def add_model(key: str) -> dict:\n        model_cache.clear()\n        model = next((m for m in _get_models() if m.key == key), None)\n        if model is None:\n            raise HTTPException(404, detail=\"unknown\")\n        try:\n            entry = synthesize_entry(model, catalog)\n        except SynthesisError as exc:\n            raise HTTPException(422, detail={\"message\": str(exc), \"key\": key}) from exc\n        catalog.add(entry)\n        _persist()\n        return {\"added\": entry.model_dump(mode=\"json\")}\n\n    @app.post(\"/api/discovered-models/add-new\")\n    def add_new() -> dict:\n        model_cache.clear()\n        added, skipped = [], []\n        for m in [m for m in _get_models() if not m.in_catalog]:\n            try:\n                entry = synthesize_entry(m, catalog)\n            except SynthesisError as exc:\n                skipped.append({\"key\": m.key, \"reason\": str(exc)})\n                continue\n            catalog.add(entry)\n            added.append(entry.public_id)\n        _persist()\n        return {\"added\": added, \"skipped\": skipped}\n\n    @app.delete(\"/api/catalog/{public_id}\")\n    def remove_model(public_id: str) -> dict:\n        entry = catalog.by_public_id(public_id)\n        if entry is None:\n            raise HTTPException(404, detail=\"unknown\")\n        busy = lifecycle.occupying_pid(entry) is not None or ops.active_for(public_id)\n        if entry.origin != \"local\" or busy:\n            raise HTTPException(409, detail={\"message\": \"config entry, or loaded/busy\"})\n        catalog.remove(public_id)\n        _persist()\n        return {\"removed\": public_id}\n\nSelf-verify: ruff and mypy clean.",
      "contracts": [
        "route:DELETE /api/catalog/{public_id}",
        "route:POST /api/discovered-models/add-new",
        "route:POST /api/discovered-models/{key}/add"
      ],
      "tests": [
        "tests/test_catalog_add_api.py::test_add_new_adds_every_synthesizable_new_model_on_distinct_ports",
        "tests/test_catalog_add_api.py::test_add_puts_the_model_in_the_live_catalog_and_the_local_file",
        "tests/test_catalog_add_api.py::test_add_unknown_key_is_404_and_changes_nothing",
        "tests/test_catalog_add_api.py::test_add_unsynthesizable_is_422_with_the_reason",
        "tests/test_catalog_add_api.py::test_added_model_is_no_longer_newly_found",
        "tests/test_catalog_add_api.py::test_remove_deletes_a_local_entry_from_catalog_and_file",
        "tests/test_catalog_add_api.py::test_remove_refuses_a_loaded_local_entry",
        "tests/test_catalog_add_api.py::test_remove_refuses_config_entries_and_unknown_ids"
      ]
    },
