class MemoryConflict(Exception):
    def __init__(
        self,
        required_gb: float | None,
        candidates: list[str],
        uncertain: list[str] | None = None,
    ) -> None:
        self.required_gb = required_gb
        self.candidates = candidates
        self.uncertain = uncertain or []
        total_required = (
            f"~{required_gb:.0f} GB" if required_gb is not None else "unknown size"
        )
        if candidates:
            message = (
                f"loading needs {total_required}; {len(candidates)} loaded model(s) "
                f"would need eviction: {', '.join(candidates)}"
            )
        else:
            message = (
                f"loading needs {total_required}; not enough memory is free and "
                f"nothing loaded can be evicted — held by a process Vortex cannot "
                f"identify: {', '.join(self.uncertain)}"
            )
        super().__init__(message)
