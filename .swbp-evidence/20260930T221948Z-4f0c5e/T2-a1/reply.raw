def _check_port(port: int | None) -> bool:
    """Return True when a TCP connection to 127.0.0.1:port succeeds within 0.5s."""
    if port is None:
        return False
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.5):
            return True
    except OSError:
        return False
