    {
      "id": "external:lmstudio-api-v1-models",
      "probe": "curl -s http://127.0.0.1:1234/api/v1/models",
      "capture": "captures/lmstudio-api-v1-models.json",
      "notes": "Object with a models array; the spec relies on key, format (mlx|gguf), architecture, size_bytes. Discovery has read it since v32; declared here for the first time."
    }
